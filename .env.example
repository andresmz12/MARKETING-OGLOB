# Railway Postgres (copia DATABASE_URL del servicio Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/railway"
# Firma de sesiones: openssl rand -base64 32
AUTH_SECRET="cambia-esto"
# Protege /api/cron/dispatch y los webhooks que Make llama de vuelta
CRON_SECRET="cambia-esto-tambien"
# Webhook de Make para publicar (un escenario por plataforma o uno con router)
MAKE_PUBLISH_WEBHOOK_URL="https://hook.make.com/xxxx"
# Usuario admin inicial (db:seed)
SEED_ADMIN_EMAIL="admin@ejemplo.com"
SEED_ADMIN_PASSWORD="cambia-esto"
